# PostgREST Configuration
# Copy this file to .env and fill in your server details

# PostgREST API URL (e.g., http://your-server.com/api for production, http://localhost/api for local)
VITE_POSTGREST_URL=http://localhost/api

# PostgreSQL password for database and PostgREST
# Needs also be set in docker/postgres/init.sql
POSTGRES_PASSWORD=change_this_secure_password

# JWT secret for PostgREST (optional, can be empty for anonymous-only access)
PGRST_JWT_SECRET=

# Base path for the application (use / for root, /zeilenschreiben/ for subpath)
VITE_BASE_PATH=/
